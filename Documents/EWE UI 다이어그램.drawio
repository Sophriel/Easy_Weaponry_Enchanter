  <diagram name="페이지-1" id="cTrOnd5WizlI9jCsCcZu">
    <mxGraphModel dx="1944" dy="1754" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    class ULocalPlayerSubsystem {\n        &lt;&lt;Engine&gt;&gt;\n    }\n\n    class UEWELocalUIManageSubsystem {\n        +Initialize(FSubsystemCollectionBase&amp;)\n        +Deinitialize()\n        +PlayerControllerChanged(APlayerController*)\n        +AddUIWidgets()\n        +ToggleInventory() / Open / Close\n        +SyncInventoryWeapons(TArray~UEWEWeaponData*~)\n        +AddWeaponToQuickSlot / SetQuickSlot / SelectQuickSlot / ScrollQuickSlot\n        +BindQuickSlot() / BindStatus() / BindTargetInfo()\n        +ShowTargetInfo / HideTargetInfo / UpdateTargetInfo / ClearTargetInfo\n        #GetUIConfigAsset() const\n        #AreEssentialWidgetsInViewport() const\n        #ClearUILoadedSubscription()\n        #HandleSlotSelected(int32, UEWEWeaponData*)\n        -TSoftObjectPtr~UEWEUIAsset~ UIConfigAsset\n        -FDelegateHandle UILoadedHandle\n        -TObjectPtr~APlayerController~ CurrentPlayerController\n        -TObjectPtr~UEWEInventory~ InventoryWidget\n        -TObjectPtr~UEWEQuickSlot~ QuickSlotWidget\n        -TObjectPtr~UEWEStatus~ StatusWidget\n        -TObjectPtr~UEWETargetInfo~ TargetInfoWidget\n        -TObjectPtr~UEWEQuickSlotViewModel~ QuickSlotViewModel\n        -TObjectPtr~UEWEStatusViewModel~ StatusViewModel\n        -TObjectPtr~UEWETargetInfoViewModel~ TargetInfoViewModel\n    }\n\n    class AEWEPlayerController {\n        +GetUIManager() UEWELocalUIManageSubsystem*\n        -TObjectPtr~UEWELocalUIManageSubsystem~ CachedUIManager\n    }\n\n    class UEWEInventory {\n        +OpenInventory() / CloseInventory()\n        +IsInventoryOpen() bool\n        +SetWeapons(TArray~UEWEWeaponData*~)\n    }\n    class UEWEQuickSlot {\n        +SetViewModel(UEWEQuickSlotViewModel*)\n    }\n    class UEWEStatus\n    class UEWETargetInfo\n\n    class UEWEQuickSlotViewModel {\n        +OnSlotSelected\n        +InitializeSlots(int32)\n        +SeedFromInventory(...)\n        +SelectSlot / AddWeapon / SetSlot / ScrollSlot\n        +IsEmpty() bool\n    }\n    class UEWEStatusViewModel {\n        +SetSource(UAbilitySystemComponent*)\n    }\n    class UEWETargetInfoViewModel {\n        +SetTarget(FText, UAbilitySystemComponent*)\n        +ClearTarget()\n    }\n\n    class UEWEUIAsset {\n        +OnUILoaded\n        +IsWidgetsLoaded() bool\n        +InventoryWidgetClass\n        +QuickSlotWidgetClass\n        +StatusWidgetClass\n        +TargetInfoWidgetClass\n        +QuickSlotCount\n    }\n    class UEWESettings {\n        +UIConfigAsset\n    }\n\n    class IEWECharacterInterface {\n        &lt;&lt;interface&gt;&gt;\n        +EquipWeapon(UEWEWeaponData*)\n    }\n    class AEWECharacter {\n        +RefreshTargetInfo()\n    }\n    class UEWEInventoryComponent {\n        +GetAllWeapons()\n    }\n    class UEWEWeaponData\n    class UAbilitySystemComponent {\n        &lt;&lt;GAS&gt;&gt;\n    }\n    class UMVVMView {\n        &lt;&lt;Engine&gt;&gt;\n        +SetViewModel(FName, UObject*)\n    }\n\n    ULocalPlayerSubsystem &lt;|-- UEWELocalUIManageSubsystem\n\n    AEWEPlayerController --&gt; UEWELocalUIManageSubsystem : caches, delegates UI calls\n    UEWEInventory ..&gt; UEWELocalUIManageSubsystem : GetSubsystem on close\n\n    UEWELocalUIManageSubsystem *-- UEWEInventory : creates / owns\n    UEWELocalUIManageSubsystem *-- UEWEQuickSlot : creates / owns\n    UEWELocalUIManageSubsystem *-- UEWEStatus : creates / owns\n    UEWELocalUIManageSubsystem *-- UEWETargetInfo : creates / owns\n    UEWELocalUIManageSubsystem *-- UEWEQuickSlotViewModel : NewObject\n    UEWELocalUIManageSubsystem *-- UEWEStatusViewModel : NewObject\n    UEWELocalUIManageSubsystem *-- UEWETargetInfoViewModel : NewObject\n\n    UEWELocalUIManageSubsystem --&gt; UEWEUIAsset : soft ref, OnUILoaded\n    UEWELocalUIManageSubsystem ..&gt; UEWESettings : reads UIConfigAsset\n    UEWELocalUIManageSubsystem ..&gt; IEWECharacterInterface : EquipWeapon\n    UEWELocalUIManageSubsystem ..&gt; AEWECharacter : RefreshTargetInfo\n    UEWELocalUIManageSubsystem ..&gt; UEWEInventoryComponent : GetAllWeapons\n    UEWELocalUIManageSubsystem ..&gt; UAbilitySystemComponent : binds to VM source\n    UEWELocalUIManageSubsystem ..&gt; UMVVMView : injects ViewModel\n    UEWELocalUIManageSubsystem ..&gt; UEWEWeaponData\n\n    UEWESettings --&gt; UEWEUIAsset\n    UEWEQuickSlot --&gt; UEWEQuickSlotViewModel : bound VM\n    AEWECharacter ..|&gt; IEWECharacterInterface\n    AEWECharacter *-- UEWEInventoryComponent\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GwnZdsNC3ox7ULvUMSh4-1">
